{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Resolve the sibling cores from source so typecheck/dev need no prior build.
		// (The published deps are via package.json `dependencies`.)
		"paths": {
			"@glowbox/led-grid": ["../led-grid/src/index.ts"],
			"@glowbox/nixie": ["../nixie/src/index.ts"]
		}
	},
	// nixie's source uses import.meta.glob; pull in its vite/client reference too.
	"include": ["src", "../nixie/src/vite-env.d.ts"]
}
