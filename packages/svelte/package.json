{
	"name": "@glowbox/svelte",
	"version": "1.10.0",
	"description": "glowbox components for Svelte 5 — <LedGrid> (3D WebGL LED grid), <NixieTube>, <SevenSegment>, <FlipDots>, <SplitFlap>, <NeonSign>, <VfdPanel> and <LcdModule>, over the sibling display cores.",
	"keywords": [
		"glowbox",
		"svelte",
		"led",
		"led-cube",
		"webgl",
		"voxel",
		"3d",
		"nixie",
		"seven-segment",
		"flip-dot",
		"split-flap",
		"neon",
		"vfd",
		"lcd",
		"retro-display",
		"component"
	],
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eetu/glowbox.git",
		"directory": "packages/svelte"
	},
	"homepage": "https://eetu.github.io/glowbox/",
	"scripts": {
		"build": "svelte-package",
		"prepack": "svelte-package",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"size": "size-limit"
	},
	"size-limit": [
		{
			"name": "shipped files (no bundle — components ship as .svelte source)",
			"path": "dist/**/*.{js,svelte}",
			"limit": "12 kB"
		}
	],
	"peerDependencies": {
		"svelte": "^5"
	},
	"dependencies": {
		"@glowbox/flip-dot": "workspace:^",
		"@glowbox/lcd": "workspace:^",
		"@glowbox/led-grid": "workspace:^",
		"@glowbox/neon": "workspace:^",
		"@glowbox/nixie": "workspace:^",
		"@glowbox/seven-segment": "workspace:^",
		"@glowbox/split-flap": "workspace:^",
		"@glowbox/vfd": "workspace:^"
	},
	"devDependencies": {
		"@anarkisti/eslint-config": "^1",
		"@size-limit/file": "^13",
		"@sveltejs/package": "^2.5",
		"@sveltejs/vite-plugin-svelte": "^7",
		"@vitest/browser": "^4.1",
		"@vitest/browser-playwright": "^4.1",
		"eslint": "^10",
		"playwright": "^1.62",
		"size-limit": "^13",
		"svelte": "^5.56",
		"svelte-check": "^4.7",
		"typescript": "^6",
		"vite": "^8.2",
		"vitest": "^4.1",
		"vitest-browser-svelte": "^3.0"
	}
}
