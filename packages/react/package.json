{
	"name": "@glowbox/react",
	"version": "1.10.0",
	"description": "glowbox components for React — <LedGrid> (3D WebGL LED grid), <NixieTube>, <SevenSegment>, <FlipDots>, <SplitFlap>, <NeonSign>, <VfdPanel> and <LcdModule>, over the sibling display cores.",
	"keywords": [
		"glowbox",
		"react",
		"led",
		"led-cube",
		"webgl",
		"voxel",
		"3d",
		"nixie",
		"seven-segment",
		"flip-dot",
		"split-flap",
		"neon",
		"vfd",
		"lcd",
		"retro-display",
		"component"
	],
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eetu/glowbox.git",
		"directory": "packages/react"
	},
	"homepage": "https://eetu.github.io/glowbox/",
	"scripts": {
		"build": "vite build",
		"prepack": "vite build",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"size": "size-limit"
	},
	"size-limit": [
		{
			"name": "esm (own code; react + cores external)",
			"path": "dist/index.js",
			"ignore": [
				"react",
				"react-dom",
				"react/jsx-runtime",
				"@glowbox/flip-dot",
				"@glowbox/lcd",
				"@glowbox/neon",
				"@glowbox/split-flap",
				"@glowbox/led-grid",
				"@glowbox/nixie",
				"@glowbox/seven-segment",
				"@glowbox/vfd"
			],
			"limit": "2.5 kB"
		}
	],
	"peerDependencies": {
		"react": "^18 || ^19"
	},
	"dependencies": {
		"@glowbox/flip-dot": "workspace:^",
		"@glowbox/lcd": "workspace:^",
		"@glowbox/led-grid": "workspace:^",
		"@glowbox/neon": "workspace:^",
		"@glowbox/nixie": "workspace:^",
		"@glowbox/seven-segment": "workspace:^",
		"@glowbox/split-flap": "workspace:^",
		"@glowbox/vfd": "workspace:^"
	},
	"devDependencies": {
		"@anarkisti/eslint-config": "^1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"@vitest/browser": "^4.1",
		"@vitest/browser-playwright": "^4.1",
		"eslint": "^10",
		"playwright": "^1.61",
		"react": "^19",
		"react-dom": "^19",
		"typescript": "^6",
		"vite": "^8.1",
		"vite-plugin-dts": "^5",
		"vitest": "^4.1",
		"vitest-browser-react": "^2"
	}
}
