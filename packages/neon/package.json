{
	"name": "@glowbox/neon",
	"version": "1.8.0",
	"description": "Glass-tube neon sign component — text bent into single-stroke tubes (vendored Hershey faces), visible unlit glass, electrode strike sequences, ageing tubes, flasher programs and an optional transformer hum, in the glowbox family.",
	"keywords": [
		"glowbox",
		"neon",
		"neon-sign",
		"sign",
		"glow",
		"retro",
		"display",
		"hershey"
	],
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"LICENSE-hershey"
	],
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eetu/glowbox.git",
		"directory": "packages/neon"
	},
	"homepage": "https://eetu.github.io/glowbox/",
	"scripts": {
		"build": "vite build",
		"prepack": "vite build",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"size": "size-limit"
	},
	"size-limit": [
		{
			"name": "esm (core + two vendored Hershey stroke faces + SVG path parser)",
			"path": "dist/index.js",
			"limit": "14 kB"
		}
	],
	"devDependencies": {
		"@anarkisti/eslint-config": "^1",
		"@vitest/browser": "^4.1",
		"@vitest/browser-playwright": "^4.1",
		"eslint": "^10",
		"playwright": "^1.61",
		"typescript": "^6",
		"vite": "^8.1",
		"vite-plugin-dts": "^5",
		"vitest": "^4.1"
	}
}
