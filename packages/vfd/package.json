{
	"name": "@glowbox/vfd",
	"version": "1.11.0",
	"description": "Vacuum-fluorescent display panel component — the stereo faceplate: a zoo of unlike anodes in one envelope (segment fields, lit word legends, spectrum bars, icons, tuning scale), sharing phosphor persistence, a dimmer, filament haze and filter glass, in the glowbox family.",
	"keywords": [
		"glowbox",
		"vfd",
		"vacuum-fluorescent",
		"stereo",
		"hifi",
		"spectrum-analyzer",
		"14-segment",
		"retro",
		"display"
	],
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eetu/glowbox.git",
		"directory": "packages/vfd"
	},
	"homepage": "https://eetu.github.io/glowbox/",
	"scripts": {
		"build": "vite build",
		"prepack": "vite build",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"size": "size-limit"
	},
	"size-limit": [
		{
			"name": "esm (core + 7/14/16-segment geometry + vendored 5×7 face + SVG path parser)",
			"path": "dist/index.js",
			"limit": "12 kB"
		}
	],
	"devDependencies": {
		"@anarkisti/eslint-config": "^1",
		"@vitest/browser": "^4.1",
		"@vitest/browser-playwright": "^4.1",
		"eslint": "^10",
		"playwright": "^1.62",
		"typescript": "^6",
		"vite": "^8.2",
		"vite-plugin-dts": "^5",
		"vitest": "^4.1"
	}
}
